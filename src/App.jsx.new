  border: 2px solid #333;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
  margin-bottom: 20px;
  // Ensure SVG is positioned correctly within the head
  display: flex;
  justify-content: center;
  align-items: flex-end; // Align mouth towards the bottom
