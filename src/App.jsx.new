import React, { useState, useRef, useEffect } from "react";
// Assuming your CSS files are set up correctly
import "./App.css"; // Contains general styles if needed
import "./Doc.css"; // Contains specific styles for the face/doctor

// --- Style Definition (Add this to your CSS file e.g., Doc.css) ---
/*
