export default function DoctorBody({ size }) {
  const scale = size / 100;
  const torsoWidth = 80 * scale;
  const torsoHeight = 120 * scale;
  const shoulderWidth = 15 * scale;
  const shoulderAngle = 15; // Degrees
  const armLength = 90 * scale;
  const armAngleOffset = 10; // Additional angle for the arms
  const sleeveWidth = 25 * scale;
  const whiteShirtHeight = 80 * scale;
  const whiteShirtOffsetY = 20 * scale;
  const centerX = 100 * scale;
  const centerY = 100 * scale;

  // Helper function to calculate rotated point
  const rotatePoint = (cx, cy, x, y, angle) => {
    const radians = (Math.PI / 180) * angle;
    const cos = Math.cos(radians);
    const sin = Math.sin(radians);
    const nx = cos * (x - cx) - sin * (y - cy) + cx;
    const ny = sin * (x - cx) + cos * (y - cy) + cy;
    return { x: nx, y: ny };
  };

  // Shoulder points
  const shoulderLeftOuter = {
    x: centerX - torsoWidth / 2 - shoulderWidth,
    y: centerY - torsoHeight / 2,
  };
  const shoulderLeftInner = {
    x: centerX - torsoWidth / 2,
    y:
      centerY -
      torsoHeight / 2 +
      shoulderWidth * Math.tan((shoulderAngle * Math.PI) / 180),
  };
  const shoulderRightInner = {
    x: centerX + torsoWidth / 2,
    y:
      centerY -
      torsoHeight / 2 +
      shoulderWidth * Math.tan((shoulderAngle * Math.PI) / 180),
  };
  const shoulderRightOuter = {
    x: centerX + torsoWidth / 2 + shoulderWidth,
    y: centerY - torsoHeight / 2,
  };

  // Arm start points (following the shoulder angle)
  const armLeftStart = shoulderLeftInner;
  const armRightStart = shoulderRightInner;

  // Calculate end points for the angled arms
  const armLeftEnd = rotatePoint(
    armLeftStart.x,
    armLeftStart.y,
    armLeftStart.x - armLength,
    armLeftStart.y,
    -shoulderAngle - armAngleOffset,
  );
  const armRightEnd = rotatePoint(
    armRightStart.x,
    armRightStart.y,
    armRightStart.x + armLength,
    armRightStart.y,
    shoulderAngle + armAngleOffset,
  );

  //viewBox={`0 0 ${200 * scale} ${200 * scale}`}
  return (
    <svg width="240" height="320" viewBox="0 0 240 320">
      <rect
        x="70"
        y="70"
        width="100"
        height="170"
        rx="24"
        fill="#b3d8f6"
        stroke="#7ab6e5"
        stroke-width="3"
      />
      <rect
        x="170"
        y="130"
        width="48"
        height="120"
        rx="20"
        fill="#b3d8f6"
        stroke="#7ab6e5"
        stroke-width="2"
        transform="rotate(-22 46 170)"
      />
      <rect
        x="22"
        y="130"
        width="48"
        height="120"
        rx="20"
        fill="#b3d8f6"
        stroke="#7ab6e5"
        stroke-width="2"
        transform="rotate(22 194 170)"
      />

      <polygon
        points="70,70 100,70 90,110 70,100"
        fill="#b3d8f6"
        stroke="#7ab6e5"
        stroke-width="2"
      />

      {/*
      <polygon
        points="70,70 120,70 90,110 70,100"
        fill="#e6f2fb"
        stroke="#7a11e5"
        stroke-width="2"
      />

        */}

      {/*
      <polygon
        points="70,70 100,70 90,110 70,100"
        fill="#e6f2fb"
        stroke="#7ab6e5"
        stroke-width="2"
      />
      <polygon
        points="170,70 140,70 150,110 170,100"
        fill="#e6f2fb"
        stroke="#7ab6e5"
        stroke-width="2"
      />

        */}

      <rect
        x="85"
        y="180"
        width="22"
        height="34"
        rx="5"
        fill="#e6f2fb"
        stroke="#7ab6e5"
        stroke-width="1.5"
      />
      <rect
        x="133"
        y="180"
        width="22"
        height="34"
        rx="5"
        fill="#e6f2fb"
        stroke="#7ab6e5"
        stroke-width="1.5"
      />

      <circle cx="120" cy="120" r="4" fill="#7ab6e5" />
      <circle cx="120" cy="150" r="4" fill="#7ab6e5" />
      <circle cx="120" cy="180" r="4" fill="#7ab6e5" />
    </svg>
  );
}
